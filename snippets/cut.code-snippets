{
  "Test suite": {
    "prefix": "testsuite",
    "body": ["TESTSUITE \"${1:suite name}\"", "", "TESTCASE \"${2:case name}\"", "    PERFORM ${3:PARAGRAPH-NAME}", "    EXPECT ${4:WS-FIELD} TO BE ${5:VALUE}", ""],
    "description": "TESTSUITE with a first TESTCASE"
  },
  "Test case": {
    "prefix": "testcase",
    "body": ["TESTCASE \"${1:case name}\"", "    PERFORM ${2:PARAGRAPH-NAME}", "    EXPECT ${3:WS-FIELD} TO BE ${4:VALUE}", ""],
    "description": "TESTCASE block"
  },
  "Tagged test case": {
    "prefix": "testcase-tags",
    "body": ["TESTCASE \"${1:case name}\" TAGS \"${2:fast}\"", "    PERFORM ${3:PARAGRAPH-NAME}", "    EXPECT ${4:WS-FIELD} TO BE ${5:VALUE}", ""],
    "description": "TESTCASE with TAGS"
  },
  "Mock a static CALL": {
    "prefix": "mock-call",
    "body": ["MOCK CALL \"${1:PROGRAM}\"", "    MOVE ${2:0} TO ${3:WS-RESULT}", "END-MOCK"],
    "description": "MOCK CALL block with a body"
  },
  "Mock a file operation": {
    "prefix": "mock-file",
    "body": ["MOCK ${1|OPEN,CLOSE,READ,WRITE,REWRITE,DELETE,START,UNLOCK|} ${2:FILE-NAME}", "    ${3:*> mock body}", "END-MOCK"],
    "description": "MOCK <file-op> block"
  },
  "Mock SQL with rows": {
    "prefix": "mock-sql-rows",
    "body": ["MOCK SQL \"${1:SELECT}\" ROWS", "    ( ${2:FIELD} = ${3:value} )", "END-MOCK"],
    "description": "MOCK SQL ... ROWS cursor block"
  },
  "Verify call count": {
    "prefix": "verify",
    "body": ["VERIFY \"${1:PROGRAM}\" WAS CALLED ${2|ONCE,NEVER,AT LEAST ONCE,2 TIMES|}"],
    "description": "VERIFY expectation"
  },
  "Expect value": {
    "prefix": "expect",
    "body": ["EXPECT ${1:WS-FIELD} TO BE ${2:VALUE}"],
    "description": "EXPECT assertion"
  }
}
