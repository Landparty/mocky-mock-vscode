{
  "Test suite": {
    "prefix": "testsuite",
    "body": ["TESTSUITE \"${1:suite name}\"", "", "TESTCASE \"${2:case name}\"", "    PERFORM ${3:PARAGRAPH-NAME}", "    EXPECT ${4:WS-FIELD} TO BE ${5:VALUE}", ""],
    "description": "TESTSUITE with a first TESTCASE"
  },
  "Test case": {
    "prefix": "testcase",
    "body": ["TESTCASE \"${1:case name}\"", "    PERFORM ${2:PARAGRAPH-NAME}", "    EXPECT ${3:WS-FIELD} TO BE ${4:VALUE}", ""],
    "description": "TESTCASE block"
  },
  "Tagged test case": {
    "prefix": "testcase-tags",
    "body": ["TESTCASE \"${1:case name}\" TAGS \"${2:fast}\"", "    PERFORM ${3:PARAGRAPH-NAME}", "    EXPECT ${4:WS-FIELD} TO BE ${5:VALUE}", ""],
    "description": "TESTCASE with TAGS"
  },
  "Mock a static CALL": {
    "prefix": "mock-call",
    "body": ["MOCK CALL \"${1:PROGRAM}\"", "    MOVE ${2:0} TO ${3:WS-RESULT}", "END-MOCK"],
    "description": "MOCK CALL block with a body"
  },
  "Mock a file operation": {
    "prefix": "mock-file",
    "body": ["MOCK ${1|OPEN,CLOSE,READ,WRITE,REWRITE,DELETE,START,UNLOCK,SORT,MERGE,RELEASE,RETURN|} ${2:FILE-NAME}", "    ${3:*> mock body}", "END-MOCK"],
    "description": "MOCK <file-op> block"
  },
  "Mock SQL with rows": {
    "prefix": "mock-sql-rows",
    "body": ["MOCK SQL \"${1:SELECT}\" ROWS", "    ( ${2:FIELD} = ${3:value} )", "END-MOCK"],
    "description": "MOCK SQL ... ROWS cursor block"
  },
  "Mock a file read with rows and terminal": {
    "prefix": "mock-read-rows",
    "body": ["MOCK READ ${1:FILE-NAME} ROWS", "    ( ${2:FIELD} = ${3:value} )", "    TERMINAL ( ${4:FIELD} = ${5:value} )", "END-MOCK"],
    "description": "MOCK READ ... ROWS cursor block with a TERMINAL group for the rows-exhausted (AT END) branch"
  },
  "Mock a CALL with one response per call": {
    "prefix": "mock-call-rows",
    "body": ["MOCK ${1|CALL \"PROGRAM\",MQ \"MQGET\",DLI \"GN\"|} ROWS", "    ( ${2:FIELD} = ${3:value} )", "    TERMINAL ( ${4:FIELD} = ${5:value} )", "END-MOCK"],
    "description": "MOCK CALL/MQ/DLI ... ROWS: row N answers the Nth call of this key in the test case; TERMINAL (required here) answers every call after the last row"
  },
  "Verify call count": {
    "prefix": "verify",
    "body": ["VERIFY \"${1:PROGRAM}\" WAS CALLED ${2|ONCE,NEVER,AT LEAST ONCE,2 TIMES|}"],
    "description": "VERIFY expectation"
  },
  "Expect value": {
    "prefix": "expect",
    "body": ["EXPECT ${1:WS-FIELD} TO BE ${2:VALUE}"],
    "description": "EXPECT assertion"
  },
  "Expect comparison": {
    "prefix": "expect-compare",
    "body": ["EXPECT ${1:WS-FIELD} TO BE ${2|GREATER THAN,GREATER THAN OR EQUAL TO,LESS THAN,LESS THAN OR EQUAL TO|} ${3:VALUE}"],
    "description": "EXPECT assertion with a relational comparison (GREATER THAN / LESS THAN, optionally OR EQUAL TO); prefix with NOT before TO BE to negate"
  },
  "Before each test case": {
    "prefix": "before-each",
    "body": ["BEFORE-EACH", "    MOVE ${1:0} TO ${2:WS-FIELD}", "END-BEFORE"],
    "description": "BEFORE-EACH hook: MOVE/PERFORM steps run at the start of every test case, and MOCK blocks shared by every case (a TESTCASE mock with the same key overrides these)"
  },
  "Before all test cases": {
    "prefix": "before-all",
    "body": ["BEFORE-ALL", "    MOCK ${1|CALL,MQ,SQL,CICS,DLI,OPEN,CLOSE,READ,WRITE,REWRITE,DELETE,START,UNLOCK,SORT,MERGE,RELEASE,RETURN,ACCEPT,PARAGRAPH,SECTION|} ${2:NAME}", "    END-MOCK", "    PERFORM ${3:0100-INIT}", "END-BEFORE"],
    "description": "BEFORE-ALL hook: MOVE/PERFORM steps run once before the first test case (every case starts from the state they leave), and MOCK blocks shared by every case (BEFORE-EACH and TESTCASE mocks override these)"
  },
  "After each test case": {
    "prefix": "after-each",
    "body": ["AFTER-EACH", "    ${1|PERFORM,MOVE|} ${2:9000-CLEANUP}", "END-AFTER"],
    "description": "AFTER-EACH hook: MOVE/PERFORM steps run at the end of every test case, after its EXPECT/VERIFY (no MOCK, EXPECT or VERIFY allowed)"
  },
  "After all test cases": {
    "prefix": "after-all",
    "body": ["AFTER-ALL", "    PERFORM ${1:9000-CLOSE-FILES}", "END-AFTER"],
    "description": "AFTER-ALL hook: MOVE/PERFORM steps run once after the last test case, with the BEFORE-ALL mocks (no MOCK, EXPECT or VERIFY allowed)"
  },
  "Mock a paragraph or section": {
    "prefix": "mock-paragraph",
    "body": ["MOCK ${1|PARAGRAPH,SECTION|} ${2:PARA-NAME}", "    ${3:*> mock body}", "END-MOCK"],
    "description": "MOCK PARAGRAPH/SECTION block for an internal PROCEDURE DIVISION target"
  },
  "File status inside a file mock": {
    "prefix": "file-status",
    "body": ["FILE-STATUS IS ${1|SUCCESS,END-OF-FILE,DUPLICATE-KEY,RECORD-NOT-FOUND,FILE-NOT-FOUND,ALREADY-OPEN,NOT-OPEN,NO-CURRENT-RECORD|}"],
    "description": "FILE-STATUS IS <mnemonic> inside a MOCK <file-op> body (or a quoted two-char code, e.g. \"92\")"
  },
  "Mock a file op with a status": {
    "prefix": "mock-file-status",
    "body": ["MOCK ${1|OPEN,CLOSE,READ,WRITE,REWRITE,DELETE,START,UNLOCK|} ${2:FILE-NAME}", "    FILE-STATUS IS ${3|SUCCESS,END-OF-FILE,DUPLICATE-KEY,RECORD-NOT-FOUND,FILE-NOT-FOUND,ALREADY-OPEN,NOT-OPEN,NO-CURRENT-RECORD|}", "END-MOCK"],
    "description": "MOCK <file-op> block that sets the file status"
  },
  "Provider data table": {
    "prefix": "provider",
    "body": ["PROVIDER ${1:ProviderName}", "    HEADER ${2:FieldOne}, ${3:FieldTwo}", "    ROW ${4:\"value\"}, ${5:\"value\"}"],
    "description": "PROVIDER block with HEADER and a first ROW"
  },
  "Parameterized test case": {
    "prefix": "testcase-provider",
    "body": ["TESTCASE \"${1:case name}\" USING PROVIDER ${2:ProviderName}", "    MOVE {${3:FieldOne}} TO ${4:WS-FIELD}", "    PERFORM ${5:PARAGRAPH-NAME}", "    EXPECT ${6:WS-RESULT} TO BE {${7:FieldTwo}}"],
    "description": "TESTCASE ... USING PROVIDER — expands into one case per ROW, {Field} placeholders substitute in MOVE/EXPECT values"
  }
}
