src/**
media/**
**/*.test.ts
.vscode/**
.mocharc.json
tsconfig.json
docs/**
**/*.map
.gitignore
.superpowers/**
staging/**
dist/**
.github/**
# Claude Code session/worktree state (e.g. .claude/worktrees/<branch>/,
# a full nested checkout with its own node_modules and docs) has no
# business in the package -- exclude the whole directory rather than
# trust whatever happens to be under it on the packaging machine.
.claude/**
node_modules/**
esbuild.js
PUBLISHING.md

# esbuild bundles everything into one out/extension.js; nothing else under
# out/ (per-module tsc output from a `tsc -p ./`-era build, leftover on a
# contributor's machine or a not-fully-clean CI checkout, plus the dev
# sourcemap) should ever ship.
out/**
!out/extension.js
!out/media
!out/media/paragraphTree
!out/media/paragraphTree/**
