src/**
**/*.test.ts
.vscode/**
.mocharc.json
tsconfig.json
tsconfig.eslint.json
eslint.config.mjs
docs/**
**/*.map
.gitignore
.superpowers/**
staging/**
# Generated by scripts/install-local.js --local-deps: a wrapper batch/shell
# script embedding the developer's own local filesystem paths. Must never
# ship in a packaged .vsix.
scripts/.local/**
dist/**
.github/**
# Claude Code session/worktree state (e.g. .claude/worktrees/<branch>/,
# a full nested checkout with its own node_modules and docs) has no
# business in the package -- exclude the whole directory rather than
# trust whatever happens to be under it on the packaging machine.
.claude/**

# Same as .claude/** above, but for this repo's own dev workflow: parallel
# git worktrees live at top-level .worktrees/<branch>/, each a full nested
# checkout with its own source, node_modules, and docs.
.worktrees/**
node_modules/**
esbuild.js
PUBLISHING.md

# esbuild bundles the extension into out/extension.js; nothing else
# under out/ (per-module tsc output from a `tsc -p ./`-era build, leftover
# on a contributor's machine or a not-fully-clean CI checkout, plus dev
# sourcemaps) should ever ship. Negations below name exact files only --
# vsce's own matching is NOT gitignore last-match-wins (see
# node_modules/@vscode/vsce/out/package.js: files pass via
# `!ignore.some(match) || negate.some(match)`, two flat unordered buckets),
# so any `!`-wildcard negation would force-include everything under it
# forever, including stray .map files -- no later plain-ignore line could
# ever claw them back out.
out/**
!out/extension.js
