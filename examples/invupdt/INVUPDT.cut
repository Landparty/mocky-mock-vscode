TESTSUITE "INVUPDT all boundary categories"

*> Two inventory records are fed through the mocked READ (the tally
*> field drives EOF on the third invocation), the DB2 UPDATE succeeds,
*> the MQ put succeeds, and the operator confirms.
TESTCASE "totals two records then updates, notifies, confirms"
    MOCK OPEN INV-FILE
    END-MOCK
    MOCK READ INV-FILE
        IF UT-READ-INV-FILE-TALLY > 2
            MOVE "Y" TO WS-EOF
        ELSE
            MOVE 5 TO INV-QTY
        END-IF
    END-MOCK
    MOCK WRITE RPT-REC
    END-MOCK
    MOCK CLOSE INV-FILE
    END-MOCK
    MOCK SQL "UPDATE INVENTORY"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK MQ "MQPUT"
        MOVE 0 TO MQ-COMPCODE
    END-MOCK
    MOCK ACCEPT WS-CONFIRM
        MOVE "Y" TO WS-CONFIRM
    END-MOCK
    PERFORM MAIN-PROCESS
    EXPECT WS-TOTAL-QTY TO BE 10
    EXPECT WS-REC-COUNT TO BE 2
    EXPECT WS-SQL-STATUS TO BE "OK"
    EXPECT WS-CONFIRM TO BE "Y"
    VERIFY READ INV-FILE WAS PERFORMED 3 TIMES
    VERIFY WRITE RPT-REC WAS PERFORMED 2 TIMES
    VERIFY OPEN INV-FILE WAS PERFORMED ONCE
    VERIFY CLOSE INV-FILE WAS PERFORMED ONCE
    VERIFY SQL "UPDATE INVENTORY" WAS PERFORMED ONCE
    VERIFY MQ "MQPUT" WAS CALLED ONCE
    VERIFY ACCEPT WS-CONFIRM WAS PERFORMED ONCE

*> A failing DB2 UPDATE (SQLCODE -911, deadlock) must flow into the
*> program's error branch without touching MQ behavior.
TESTCASE "sql failure sets FAIL status"
    MOCK OPEN INV-FILE
    END-MOCK
    MOCK READ INV-FILE
        MOVE "Y" TO WS-EOF
    END-MOCK
    MOCK WRITE RPT-REC
    END-MOCK
    MOCK CLOSE INV-FILE
    END-MOCK
    MOCK SQL "UPDATE INVENTORY"
        MOVE -911 TO SQLCODE
    END-MOCK
    MOCK MQ "MQPUT"
        MOVE 0 TO MQ-COMPCODE
    END-MOCK
    MOCK ACCEPT WS-CONFIRM
        MOVE "N" TO WS-CONFIRM
    END-MOCK
    PERFORM MAIN-PROCESS
    EXPECT WS-SQL-STATUS TO BE "FAIL"
    EXPECT WS-REC-COUNT TO BE 0
    VERIFY READ INV-FILE WAS PERFORMED ONCE
    VERIFY WRITE RPT-REC WAS PERFORMED NEVER
