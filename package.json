{
  "name": "mockymock-vscode",
  "displayName": "mockymock",
  "description": "Write, run, debug and cover COBOL unit tests from VS Code -- no mainframe needed.",
  "version": "0.11.0",
  "publisher": "lanparty",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Landparty/mocky-mock-vscode.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cut",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mockymock.newTestSuite",
        "title": "New Test Suite for This Program",
        "category": "mockymock",
        "icon": "$(beaker)"
      },
      {
        "command": "mockymock.openTestSuite",
        "title": "Open Test Suite",
        "category": "mockymock",
        "icon": "$(beaker)"
      },
      {
        "command": "mockymock.openProgram",
        "title": "Open Program Under Test",
        "category": "mockymock",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mockymock.fillMissingMocks",
        "title": "Fill In Missing Mocks",
        "category": "mockymock",
        "icon": "$(wand)"
      },
      {
        "command": "mockymock.exportMainframe",
        "title": "Export Mainframe-Ready COBOL",
        "category": "mockymock",
        "icon": "$(export)"
      },
      {
        "command": "mockymock.checkEnvironment",
        "title": "Check Setup (CLI and Docker)",
        "category": "mockymock",
        "icon": "$(pulse)"
      },
      {
        "command": "mockymock.openWalkthrough",
        "title": "Open Getting Started Guide",
        "category": "mockymock",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mockymock.newTestSuite",
          "when": "resourceLangId == cobol && !(resourceFilename =~ /\\.mainframe\\.cbl$/) && !mockymock.activeProgramHasSuite",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.openTestSuite",
          "when": "resourceLangId == cobol && !(resourceFilename =~ /\\.mainframe\\.cbl$/) && mockymock.activeProgramHasSuite",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.openProgram",
          "when": "resourceLangId == cut && mockymock.activeSuiteHasProgram",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.fillMissingMocks",
          "when": "resourceLangId == cut",
          "group": "1_mockymock@1"
        },
        {
          "command": "mockymock.exportMainframe",
          "when": "resourceLangId == cut || resourceLangId == cobol && mockymock.activeProgramHasSuite",
          "group": "1_mockymock@2"
        }
      ],
      "editor/context": [
        {
          "command": "mockymock.newTestSuite",
          "when": "resourceLangId == cobol && !(resourceFilename =~ /\\.mainframe\\.cbl$/) && !mockymock.activeProgramHasSuite",
          "group": "mockymock@0"
        },
        {
          "command": "mockymock.openTestSuite",
          "when": "resourceLangId == cobol && !(resourceFilename =~ /\\.mainframe\\.cbl$/) && mockymock.activeProgramHasSuite",
          "group": "mockymock@0"
        },
        {
          "command": "mockymock.openProgram",
          "when": "resourceLangId == cut && mockymock.activeSuiteHasProgram",
          "group": "mockymock@0"
        },
        {
          "command": "mockymock.fillMissingMocks",
          "when": "resourceLangId == cut",
          "group": "mockymock@1"
        }
      ],
      "explorer/context": [
        {
          "command": "mockymock.newTestSuite",
          "when": "resourceLangId == cobol && !(resourceFilename =~ /\\.mainframe\\.cbl$/)",
          "group": "7_mockymock@1"
        },
        {
          "command": "mockymock.fillMissingMocks",
          "when": "resourceLangId == cut",
          "group": "7_mockymock@1"
        },
        {
          "command": "mockymock.exportMainframe",
          "when": "resourceLangId == cut",
          "group": "7_mockymock@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mockymock.newTestSuite",
          "when": "resourceLangId == cobol || resourceLangId == cut"
        },
        {
          "command": "mockymock.openTestSuite",
          "when": "resourceLangId == cobol"
        },
        {
          "command": "mockymock.openProgram",
          "when": "resourceLangId == cut"
        },
        {
          "command": "mockymock.exportMainframe",
          "when": "resourceLangId == cobol || resourceLangId == cut"
        },
        {
          "command": "mockymock.fillMissingMocks",
          "when": "resourceLangId == cut"
        }
      ]
    },
    "debuggers": [
      {
        "type": "mockymock-cobol",
        "label": "mockymock COBOL",
        "languages": [
          "cut",
          "cobol"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "cut",
              "case"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the COBOL program under test (.cbl/.cob/.cobol).",
                "default": "${workspaceFolder}/PROGRAM.cbl"
              },
              "cut": {
                "type": "string",
                "description": "Absolute path to the .cut test suite containing the TESTCASE to debug.",
                "default": "${workspaceFolder}/PROGRAM.cut"
              },
              "case": {
                "type": "string",
                "description": "Name of the single TESTCASE to debug, exactly as written in the .cut file. mockymock debug runs exactly one case per session."
              },
              "executablePath": {
                "type": "string",
                "description": "Override the mockymock executable for this session only. Defaults to the mockymock.executablePath setting, then the bundled CLI, then 'mockymock' on PATH."
              },
              "copybookPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Folders passed as --copybook-path for resolving COPY / EXEC SQL INCLUDE members. Defaults to the mockymock.copybookPaths setting when omitted.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mockymock-cobol",
            "request": "launch",
            "name": "mockymock: debug a TESTCASE",
            "program": "${workspaceFolder}/PROGRAM.cbl",
            "cut": "${workspaceFolder}/PROGRAM.cut",
            "case": "the testcase name"
          }
        ],
        "configurationSnippets": [
          {
            "label": "mockymock: debug a TESTCASE",
            "description": "Debug one TESTCASE from a .cut suite with mockymock.",
            "body": {
              "type": "mockymock-cobol",
              "request": "launch",
              "name": "mockymock: ${1:testcase name}",
              "program": "^\"\\${workspaceFolder}/${2:PROGRAM.cbl}\"",
              "cut": "^\"\\${workspaceFolder}/${3:PROGRAM.cut}\"",
              "case": "${1:testcase name}"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "cobol",
        "aliases": [
          "COBOL",
          "cobol"
        ],
        "extensions": [
          ".cbl",
          ".cob",
          ".cobol"
        ]
      },
      {
        "id": "cut",
        "aliases": [
          "mockymock .cut",
          "cut"
        ],
        "extensions": [
          ".cut"
        ],
        "configuration": "./language/cut-language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "cobol"
      }
    ],
    "grammars": [
      {
        "language": "cut",
        "scopeName": "source.cut",
        "path": "./syntaxes/cut.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cut",
        "path": "./snippets/cut.code-snippets"
      }
    ],
    "configuration": {
      "title": "mockymock",
      "properties": {
        "mockymock.copybookPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "order": 1,
          "markdownDescription": "Folders to search for `COPY` and `EXEC SQL INCLUDE` members, e.g. `[\"copybooks\", \"../shared/cpy\"]`. Relative paths resolve against the workspace folder.\n\n**Usually you don't need to set this:** when it's unset, `cobolAnalyzer.copybookPaths` is used, and a `zapp.yml` at the workspace root is read automatically. Set it to `[]` to turn that inheritance off."
        },
        "mockymock.lintOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 2,
          "markdownDescription": "Check `.cut` suites against their program as you open and save them, and show problems in the editor. Fast and offline — no Docker needed."
        },
        "mockymock.maxParallelRuns": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "scope": "window",
          "order": 3,
          "markdownDescription": "How many `.cut` files may run at once. Each compiles in the shared GnuCOBOL container, so keep this at `1` unless your machine has room to spare."
        },
        "mockymock.executablePath": {
          "type": "string",
          "default": "",
          "order": 4,
          "markdownDescription": "Path to a `mockymock` CLI to use instead of the one bundled with this extension. **Leave empty** unless you know you need a different build."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "testing",
        "contents": "No mockymock test suites yet. A test suite is a .cut file that sits next to your COBOL program.\n[Create a Test Suite](command:mockymock.newTestSuite)\nNew to mockymock? The [Getting Started guide](command:mockymock.openWalkthrough) walks you through setup, your first suite, and debugging."
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with mockymock",
        "description": "Write, run and debug COBOL unit tests on your own machine -- no mainframe needed.",
        "steps": [
          {
            "id": "checkSetup",
            "title": "Check your setup",
            "description": "mockymock needs two things: its CLI (already bundled with this extension) and Docker Desktop, which runs the COBOL compiler in a container. One click checks both and fixes what it can.\n[Check Setup](command:mockymock.checkEnvironment)",
            "media": {
              "markdown": "walkthroughs/check-setup.md"
            },
            "completionEvents": [
              "onCommand:mockymock.checkEnvironment"
            ]
          },
          {
            "id": "createSuite",
            "title": "Create your first test suite",
            "description": "Open a COBOL program (.cbl, .cob or .cobol), then create a .cut test suite next to it. mockymock reads the program and scaffolds one test case per paragraph, with every CALL, file, SQL, CICS and IMS boundary already mocked.\n[Create a Test Suite](command:mockymock.newTestSuite)",
            "media": {
              "markdown": "walkthroughs/create-suite.md"
            },
            "completionEvents": [
              "onCommand:mockymock.newTestSuite"
            ]
          },
          {
            "id": "runTests",
            "title": "Run your tests",
            "description": "Every .cut file shows up in the Test Explorer, and every TESTCASE gets a play button in the editor gutter. Failures land on the failing line with an expected/actual diff.\n[Open Test Explorer](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "walkthroughs/run-tests.md"
            },
            "completionEvents": [
              "onCommand:workbench.view.testing.focus",
              "onView:workbench.view.testing"
            ]
          },
          {
            "id": "debugTests",
            "title": "Debug a test case",
            "description": "Set a breakpoint in your .cbl, then right-click a test case and pick **Debug (Interactive)** to step through your original COBOL with live variables. Prefer a read-only view? **Debug (Execution Trace)** prints the executed path and every mock that fired.\n[Open Test Explorer](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "walkthroughs/debug-tests.md"
            },
            "completionEvents": [
              "stepSelected"
            ]
          },
          {
            "id": "goFurther",
            "title": "Coverage, mutation testing and more",
            "description": "**Run with Coverage** paints executed lines on your .cbl. **Mutation Test** tells you which bugs your tests would miss. The button in the editor title bar (or Ctrl+Alt+O, Cmd+Alt+O on macOS) jumps between a program and its suite. For COBOL language support and static analysis, add the companion COBOL Analyzer extension.\n[Browse the examples](https://github.com/Landparty/mocky-mock-vscode/tree/main/examples)",
            "media": {
              "markdown": "walkthroughs/go-further.md"
            },
            "completionEvents": [
              "stepSelected"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "mockymock.openTestSuite",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && editorLangId == cobol"
      },
      {
        "command": "mockymock.openProgram",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && editorLangId == cut"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test:unit": "mocha",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "package": "vsce package",
    "install-local": "node scripts/install-local.js",
    "install-local:local-deps": "node scripts/install-local.js --local-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "glob": "^13.0.6",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0"
  },
  "keywords": [
    "cobol",
    "unit test",
    "mock",
    "mainframe",
    "gnucobol",
    "coverage",
    "debugger"
  ]
}
