{
  "name": "mockymock-vscode",
  "displayName": "mockymock",
  "description": "Run mockymock .cut COBOL test suites directly from VS Code.",
  "version": "0.9.0",
  "publisher": "lanparty",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Landparty/mocky-mock-vscode.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cut",
    "onLanguage:cobol",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mockymock.checkEnvironment",
        "title": "Check Environment Status",
        "category": "mockymock"
      },
      {
        "command": "mockymock.exportMainframe",
        "title": "Export Mainframe-Ready COBOL",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol",
        "title": "Analyze COBOL File...",
        "category": "mockymock"
      },
      {
        "command": "mockymock.generateData",
        "title": "Generate Data from Copybook",
        "category": "mockymock",
        "icon": "$(table)"
      },
      {
        "command": "mockymock.boundaries.refresh",
        "title": "Refresh",
        "category": "mockymock",
        "icon": "$(refresh)"
      },
      {
        "command": "mockymock.boundaries.setScenarioMode",
        "title": "Scenario Mode…",
        "category": "mockymock",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mockymock.boundaries.generateCut",
        "title": "Generate .cut",
        "category": "mockymock",
        "icon": "$(play)"
      },
      {
        "command": "mockymock.paragraphTree.refresh",
        "title": "Refresh Paragraph Tree",
        "category": "mockymock",
        "icon": "$(refresh)"
      },
      {
        "command": "mockymock.programFlow.refresh",
        "title": "Refresh Program Flow",
        "category": "mockymock",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mockymock.boundaries",
          "name": "COBOL Boundaries",
          "icon": "$(symbol-interface)",
          "when": "mockymock.cobolOpen"
        },
        {
          "id": "mockymock.paragraphTree",
          "name": "Paragraph Tree",
          "type": "webview",
          "icon": "$(list-tree)",
          "when": "mockymock.cobolOpen"
        },
        {
          "id": "mockymock.programFlow",
          "name": "Program Flow",
          "type": "webview",
          "icon": "$(type-hierarchy-sub)",
          "when": "mockymock.cobolOpen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mockymock.boundaries",
        "contents": "Open a .cbl file to list its boundaries."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mockymock.generateData",
          "when": "mockymock.activeEditorIsCopybook",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mockymock.boundaries.generateCut",
          "when": "view == mockymock.boundaries",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.boundaries.refresh",
          "when": "view == mockymock.boundaries",
          "group": "navigation@2"
        },
        {
          "command": "mockymock.boundaries.setScenarioMode",
          "when": "view == mockymock.boundaries",
          "group": "navigation@3"
        },
        {
          "command": "mockymock.paragraphTree.refresh",
          "when": "view == mockymock.paragraphTree",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.programFlow.refresh",
          "when": "view == mockymock.programFlow",
          "group": "navigation@1"
        }
      ]
    },
    "debuggers": [
      {
        "type": "mockymock-cobol",
        "label": "mockymock COBOL",
        "languages": [
          "cut",
          "cobol"
        ]
      }
    ],
    "languages": [
      {
        "id": "cut",
        "aliases": [
          "mockymock .cut",
          "cut"
        ],
        "extensions": [
          ".cut"
        ],
        "configuration": "./language/cut-language-configuration.json"
      },
      {
        "id": "cobol",
        "aliases": [
          "COBOL",
          "cobol"
        ],
        "extensions": [
          ".cbl",
          ".cob",
          ".cobol"
        ],
        "configuration": "./language/cobol-language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "cobol"
      }
    ],
    "grammars": [
      {
        "language": "cut",
        "scopeName": "source.cut",
        "path": "./syntaxes/cut.tmLanguage.json"
      },
      {
        "language": "cobol",
        "scopeName": "source.cobol",
        "path": "./syntaxes/cobol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cut",
        "path": "./snippets/cut.code-snippets"
      }
    ],
    "configuration": {
      "title": "mockymock",
      "properties": {
        "mockymock.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the mockymock executable. Leave empty to use the CLI binary bundled in this extension (if present), otherwise resolve 'mockymock' from PATH."
        },
        "mockymock.copybookPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Folder paths passed as --copybook-path on every mockymock run, for resolving COPY / EXEC SQL INCLUDE members. Relative paths resolve against the .cut file's workspace folder. Resource-scoped so each folder in a multi-root workspace can set its own via that folder's .vscode/settings.json."
        },
        "mockymock.lintOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Run 'mockymock lint' (static checks only, no Docker) on open/save of a .cut file and show the problems as diagnostics."
        },
        "mockymock.maxParallelRuns": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "scope": "window",
          "description": "How many .cut files may run concurrently in one test run. Each run compiles and executes inside the shared mockymock-cobc container; raise this only if your setup tolerates concurrent compiles."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./ && tsc --noEmit -p ./media/paragraphTree && tsc --noEmit -p ./media/programFlow",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "test:unit": "mocha",
    "test:integration": "node scripts/run-integration-tests.js",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.4",
    "mermaid": "^11.16.1"
  }
}
