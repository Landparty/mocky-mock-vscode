{
  "name": "mockymock-vscode",
  "displayName": "mockymock",
  "description": "Run mockymock .cut COBOL test suites directly from VS Code.",
  "version": "0.11.0",
  "publisher": "lanparty",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Landparty/mocky-mock-vscode.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cut",
    "onLanguage:cobol",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mockymock.checkEnvironment",
        "title": "Check Environment Status",
        "category": "mockymock"
      },
      {
        "command": "mockymock.exportMainframe",
        "title": "Export Mainframe-Ready COBOL",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol",
        "title": "Analyze COBOL File...",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.deadCode",
        "title": "Analyze: Dead Code",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.programFlow",
        "title": "Analyze: Program Flow",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.ioSequence",
        "title": "Analyze: I/O Sequence",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.moveTypeCheck",
        "title": "Analyze: MOVE Type Check",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.linkageCheck",
        "title": "Analyze: Linkage Check",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.languageEnv",
        "title": "Analyze: Language Environment",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.imsDli",
        "title": "Analyze: IMS DLI",
        "category": "mockymock"
      },
      {
        "command": "mockymock.analyzeCobol.dynamicCall",
        "title": "Analyze: Dynamic Call Analysis",
        "category": "mockymock"
      },
      {
        "command": "mockymock.programFlow.show",
        "title": "Show Program Flow",
        "category": "mockymock",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "mockymock.generateData",
        "title": "Generate Data from Copybook",
        "category": "mockymock",
        "icon": "$(table)"
      },
      {
        "command": "mockymock.paragraphTree.refresh",
        "title": "Refresh Paragraph Tree",
        "category": "mockymock",
        "icon": "$(refresh)"
      },
      {
        "command": "mockymock.programFlow.refresh",
        "title": "Refresh Program Flow",
        "category": "mockymock",
        "icon": "$(refresh)"
      },
      {
        "command": "mockymock.focusStatements.toggle",
        "title": "Toggle Focus on SQL/CICS/MQ/CALL Statements",
        "category": "mockymock",
        "icon": "$(fold)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mockymock.paragraphTree",
          "name": "Paragraph Tree",
          "type": "webview",
          "icon": "$(list-tree)",
          "when": "mockymock.cobolOpen"
        },
        {
          "id": "mockymock.programFlow",
          "name": "Program Flow",
          "type": "webview",
          "icon": "$(type-hierarchy-sub)",
          "when": "mockymock.cobolOpen"
        }
      ]
    },
    "submenus": [
      {
        "id": "mockymock.analyzeCobol.submenu",
        "label": "mockymock: Analyze COBOL"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mockymock.generateData",
          "when": "mockymock.activeEditorIsCopybook",
          "group": "navigation"
        },
        {
          "command": "mockymock.focusStatements.toggle",
          "when": "resourceLangId == cobol",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "mockymock.analyzeCobol.submenu",
          "when": "resourceLangId == cobol",
          "group": "mockymock@1"
        },
        {
          "command": "mockymock.programFlow.show",
          "when": "resourceLangId == cobol",
          "group": "mockymock@2"
        }
      ],
      "mockymock.analyzeCobol.submenu": [
        {
          "command": "mockymock.analyzeCobol.deadCode",
          "group": "1_analyzers@1"
        },
        {
          "command": "mockymock.analyzeCobol.programFlow",
          "group": "1_analyzers@2"
        },
        {
          "command": "mockymock.analyzeCobol.ioSequence",
          "group": "1_analyzers@3"
        },
        {
          "command": "mockymock.analyzeCobol.moveTypeCheck",
          "group": "1_analyzers@4"
        },
        {
          "command": "mockymock.analyzeCobol.linkageCheck",
          "group": "1_analyzers@5"
        },
        {
          "command": "mockymock.analyzeCobol.languageEnv",
          "group": "1_analyzers@6"
        },
        {
          "command": "mockymock.analyzeCobol.imsDli",
          "group": "1_analyzers@7"
        },
        {
          "command": "mockymock.analyzeCobol.dynamicCall",
          "group": "1_analyzers@8"
        }
      ],
      "view/title": [
        {
          "command": "mockymock.paragraphTree.refresh",
          "when": "view == mockymock.paragraphTree",
          "group": "navigation@1"
        },
        {
          "command": "mockymock.programFlow.refresh",
          "when": "view == mockymock.programFlow",
          "group": "navigation@1"
        }
      ]
    },
    "debuggers": [
      {
        "type": "mockymock-cobol",
        "label": "mockymock COBOL",
        "languages": [
          "cut",
          "cobol"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "cut",
              "case"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the COBOL program under test (.cbl/.cob/.cobol).",
                "default": "${workspaceFolder}/PROGRAM.cbl"
              },
              "cut": {
                "type": "string",
                "description": "Absolute path to the .cut test suite containing the TESTCASE to debug.",
                "default": "${workspaceFolder}/PROGRAM.cut"
              },
              "case": {
                "type": "string",
                "description": "Name of the single TESTCASE to debug, exactly as written in the .cut file. mockymock debug runs exactly one case per session."
              },
              "executablePath": {
                "type": "string",
                "description": "Override the mockymock executable for this session only. Defaults to the mockymock.executablePath setting, then the bundled CLI, then 'mockymock' on PATH."
              },
              "copybookPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Folders passed as --copybook-path for resolving COPY / EXEC SQL INCLUDE members. Defaults to the mockymock.copybookPaths setting when omitted.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mockymock-cobol",
            "request": "launch",
            "name": "mockymock: debug a TESTCASE",
            "program": "${workspaceFolder}/PROGRAM.cbl",
            "cut": "${workspaceFolder}/PROGRAM.cut",
            "case": "the testcase name"
          }
        ],
        "configurationSnippets": [
          {
            "label": "mockymock: debug a TESTCASE",
            "description": "Debug one TESTCASE from a .cut suite with mockymock.",
            "body": {
              "type": "mockymock-cobol",
              "request": "launch",
              "name": "mockymock: ${1:testcase name}",
              "program": "^\"\\${workspaceFolder}/${2:PROGRAM.cbl}\"",
              "cut": "^\"\\${workspaceFolder}/${3:PROGRAM.cut}\"",
              "case": "${1:testcase name}"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "cut",
        "aliases": [
          "mockymock .cut",
          "cut"
        ],
        "extensions": [
          ".cut"
        ],
        "configuration": "./language/cut-language-configuration.json"
      },
      {
        "id": "cobol",
        "aliases": [
          "COBOL",
          "cobol"
        ],
        "extensions": [
          ".cbl",
          ".cob",
          ".cobol"
        ],
        "configuration": "./language/cobol-language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "cobol"
      }
    ],
    "grammars": [
      {
        "language": "cut",
        "scopeName": "source.cut",
        "path": "./syntaxes/cut.tmLanguage.json"
      },
      {
        "language": "cobol",
        "scopeName": "source.cobol",
        "path": "./syntaxes/cobol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cut",
        "path": "./snippets/cut.code-snippets"
      }
    ],
    "configuration": {
      "title": "mockymock",
      "properties": {
        "mockymock.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the mockymock executable. Leave empty to use the CLI binary bundled in this extension (if present), otherwise resolve 'mockymock' from PATH."
        },
        "mockymock.copybookPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Folder paths passed as --copybook-path on every mockymock run, for resolving COPY / EXEC SQL INCLUDE members. Relative paths resolve against the .cut file's workspace folder. Resource-scoped so each folder in a multi-root workspace can set its own via that folder's .vscode/settings.json. If a zapp.yml or zapp.yaml exists at the workspace root (the same file IBM Z Open Editor's DBB tooling uses), its cobol-language local library locations are also merged in automatically, after this setting's own entries (this setting wins on a duplicate path)."
        },
        "mockymock.lintOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Run 'mockymock lint' (static checks only, no Docker) on open/save of a .cut file and show the problems as diagnostics."
        },
        "mockymock.moveCheckOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Run 'mockymock analyze move-type-check' (static checks only, no Docker) when a .cbl/.cob/.cobol file becomes the active editor or is saved, and show MOVE statement data-category mismatches as diagnostics."
        },
        "mockymock.maxParallelRuns": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "scope": "window",
          "description": "How many .cut files may run concurrently in one test run. Each run compiles and executes inside the shared mockymock-cobc container; raise this only if your setup tolerates concurrent compiles."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./ && tsc --noEmit -p ./media/paragraphTree && tsc --noEmit -p ./media/programFlow",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test:unit": "mocha",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "package": "vsce package",
    "install-local": "node scripts/install-local.js",
    "install-local:local-deps": "node scripts/install-local.js --local-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "fast-xml-parser": "^5.11.0",
    "glob": "^13.0.6",
    "mermaid": "^11.16.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0"
  }
}
