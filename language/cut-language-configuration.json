{
  "comments": {
    "lineComment": "*>"
  },
  "brackets": [["(", ")"]],
  "wordPattern": "[A-Za-z0-9][A-Za-z0-9-]*",
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(MOCK\\b|(BEFORE|AFTER)-(ALL|EACH)\\s*$)",
      "end": "^\\s*(END-MOCK|END-BEFORE|END-AFTER)\\.?\\s*$"
    }
  }
}
