{
  "comments": {
    "lineComment": "*>"
  },
  "brackets": [["(", ")"]],
  "wordPattern": "[A-Za-z0-9][A-Za-z0-9-]*",
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(MOCK\\b|(BEFORE|AFTER)-(ALL|EACH)\\s*$)",
      "end": "^\\s*[Ee][Nn][Dd]-([Mm][Oo][Cc][Kk]|[Bb][Ee][Ff][Oo][Rr][Ee]|[Aa][Ff][Tt][Ee][Rr])\\.?\\s*$"
    }
  }
}
