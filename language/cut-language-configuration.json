{
  "comments": {
    "lineComment": "*>"
  },
  "brackets": [["(", ")"]],
  "wordPattern": "[A-Za-z0-9][A-Za-z0-9-]*",
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(MOCK\\b|BEFORE-ALL\\s*$|BEFORE-EACH\\s*$|AFTER-EACH\\s*$|AFTER-ALL\\s*$)",
      "end": "^\\s*(END-MOCK|END-BEFORE|END-AFTER)\\.?\\s*$"
    }
  }
}
