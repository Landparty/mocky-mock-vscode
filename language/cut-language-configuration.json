{
  "comments": {
    "lineComment": "*>"
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*MOCK\\b",
      "end": "^\\s*END-MOCK\\.?\\s*$"
    }
  }
}
