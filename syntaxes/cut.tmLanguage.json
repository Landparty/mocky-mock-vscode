{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mockymock .cut",
  "scopeName": "source.cut",
  "patterns": [
    { "include": "#comment" },
    { "include": "#structure" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#placeholder" },
    { "include": "#numbers" },
    { "include": "#cobol" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*\\*>.*$",
      "name": "comment.line.cut"
    },
    "structure": {
      "patterns": [
        {
          "match": "^\\s*(TESTSUITE|TESTCASE)\\b(?:\\s+(\"[^\"]*\"))?(?:\\s+(TAGS)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.structure.cut" },
            "2": { "name": "string.quoted.double.cut" },
            "3": { "name": "keyword.other.tags.cut" }
          }
        },
        {
          "match": "^\\s*(PROGRAM)(?=\\s+\")",
          "captures": {
            "1": { "name": "keyword.control.structure.cut" }
          }
        },
        {
          "match": "\\b(USING\\s+PROVIDER)\\s+([A-Za-z0-9][A-Za-z0-9-]*)(?:\\s+(TAGS)\\b)?",
          "captures": {
            "1": { "name": "keyword.other.provider.cut" },
            "2": { "name": "entity.name.provider.cut" },
            "3": { "name": "keyword.other.tags.cut" }
          }
        },
        {
          "match": "^\\s*(MOCK)\\s+(CALL|MQ|SQL|CICS|DLI|OPEN|CLOSE|READ|WRITE|REWRITE|DELETE|START|UNLOCK|SORT|MERGE|RELEASE|RETURN|ACCEPT|INITIATE|GENERATE|TERMINATE|PARAGRAPH|SECTION)\\b(\\s+ROWS\\b)?",
          "captures": {
            "1": { "name": "keyword.control.mock.cut" },
            "2": { "name": "storage.type.category.cut" },
            "3": { "name": "keyword.other.rows.cut" }
          }
        },
        {
          "match": "^\\s*(?i:(END-MOCK))\\.?\\s*$",
          "name": "keyword.control.mock.cut"
        },
        {
          "match": "^\\s*(BEFORE-ALL|BEFORE-EACH|AFTER-EACH|AFTER-ALL)\\s*$",
          "name": "keyword.control.structure.cut"
        },
        {
          "match": "^\\s*(?i:(END-BEFORE|END-AFTER))\\.?\\s*$",
          "name": "keyword.control.structure.cut"
        },
        {
          "match": "^\\s*(PROVIDER)\\s+([A-Za-z0-9][A-Za-z0-9-]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.provider.cut" },
            "2": { "name": "entity.name.provider.cut" }
          }
        },
        {
          "match": "^\\s*(HEADER)\\s+([A-Za-z][A-Za-z0-9-]*(?:\\s*,\\s*[A-Za-z][A-Za-z0-9-]*)*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.provider.cut" },
            "2": { "name": "variable.parameter.header.cut" }
          }
        },
        {
          "match": "^\\s*(ROW)\\b",
          "name": "keyword.control.provider.cut"
        },
        {
          "match": "^\\s*(TERMINAL)\\s*(?=\\()",
          "name": "keyword.other.rows.cut"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^\\s*(EXPECT)\\s+([A-Za-z0-9][A-Za-z0-9-]*(?:\\s+(?:OF|IN)\\s+[A-Za-z0-9][A-Za-z0-9-]*)*(?:\\s*\\([^)]*\\))?|\\S+)\\s+(?:(NOT)\\s+)?(TO\\s+BE)\\b(?:\\s+(GREATER\\s+THAN(?:\\s+OR\\s+EQUAL\\s+TO)?|LESS\\s+THAN(?:\\s+OR\\s+EQUAL\\s+TO)?))?",
          "captures": {
            "1": { "name": "keyword.control.assertion.cut" },
            "2": { "name": "variable.other.cobol.cut" },
            "3": { "name": "keyword.operator.negation.cut" },
            "4": { "name": "keyword.operator.words.cut" },
            "5": { "name": "keyword.operator.comparison.cut" }
          }
        },
        {
          "match": "^\\s*(VERIFY)\\s+(?:(CALL|MQ|SQL|CICS|DLI|OPEN|CLOSE|READ|WRITE|REWRITE|DELETE|START|UNLOCK|SORT|MERGE|RELEASE|RETURN|ACCEPT|INITIATE|GENERATE|TERMINATE|PARAGRAPH|SECTION)\\s+)?(.*?)\\s*(WAS\\s+(?:CALLED|PERFORMED))\\s+(ONCE|NEVER|AT\\s+LEAST\\s+ONCE|\\d+\\s+TIMES)\\b",
          "captures": {
            "1": { "name": "keyword.control.assertion.cut" },
            "2": { "name": "storage.type.category.cut" },
            "3": { "patterns": [{ "include": "#strings" }] },
            "4": { "name": "keyword.operator.words.cut" },
            "5": { "name": "constant.language.expectation.cut" }
          }
        },
        {
          "match": "^\\s*(PERFORM)\\s+(\\S+)(?:\\s+(THRU|THROUGH)\\s+(\\S+))?",
          "captures": {
            "1": { "name": "keyword.control.perform.cut" },
            "2": { "name": "entity.name.function.paragraph.cut" },
            "3": { "name": "keyword.control.perform.cut" },
            "4": { "name": "entity.name.function.paragraph.cut" }
          }
        },
        {
          "match": "^\\s*(MOVE)\\s+(.+?)\\s+(TO)\\s+([A-Za-z0-9][A-Za-z0-9-]*(?:\\s+(?:OF|IN)\\s+[A-Za-z0-9][A-Za-z0-9-]*)*(?:\\s*\\([^)]*\\))?|\\S+)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.move.cut" },
            "2": {
              "patterns": [
                { "include": "#strings" },
                { "include": "#placeholder" },
                { "include": "#numbers" }
              ]
            },
            "3": { "name": "keyword.other.move.cut" },
            "4": { "name": "variable.other.cobol.cut" }
          }
        },
        {
          "match": "^\\s*(CAPTURE)\\s+(ARG)\\s+(\\S+)\\s+(INTO)\\s+([A-Za-z0-9][A-Za-z0-9-]*(?:\\s+(?:OF|IN)\\s+[A-Za-z0-9][A-Za-z0-9-]*)*(?:\\s*\\([^)]*\\))?|\\S+)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.capture.cut" },
            "2": { "name": "keyword.other.capture.cut" },
            "3": { "patterns": [{ "include": "#numbers" }] },
            "4": { "name": "keyword.other.capture.cut" },
            "5": { "name": "variable.other.cobol.cut" }
          }
        },
        {
          "match": "^\\s*(FILE-STATUS)\\s+(IS)\\s+(?:(?i:(SUCCESS|END-OF-FILE|DUPLICATE-KEY|RECORD-NOT-FOUND|FILE-NOT-FOUND|ALREADY-OPEN|NOT-OPEN|NO-CURRENT-RECORD))\\b|(\"[^\"]*\")|([A-Za-z][A-Za-z-]*))\\s*$",
          "captures": {
            "1": { "name": "keyword.control.filestatus.cut" },
            "2": { "name": "keyword.operator.words.cut" },
            "3": { "name": "constant.language.filestatus.cut" },
            "4": { "name": "string.quoted.double.cut" },
            "5": { "name": "invalid.illegal.filestatus.cut" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.cut"
        },
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.cut"
        }
      ]
    },
    "placeholder": {
      "match": "\\{[A-Za-z][A-Za-z0-9-]*\\}",
      "name": "variable.other.placeholder.cut"
    },
    "numbers": {
      "match": "(?<![\\w-])[+-]?\\d+(?:\\.\\d+)?(?![\\w-])",
      "name": "constant.numeric.cut"
    },
    "cobol": {
      "match": "\\b(IF|ELSE|END-IF|EVALUATE|WHEN|END-EVALUATE|DISPLAY|COMPUTE|ADD|SUBTRACT|MULTIPLY|DIVIDE)\\b",
      "name": "keyword.other.cobol.cut"
    }
  }
}
