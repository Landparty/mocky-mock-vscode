{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IBM Enterprise COBOL",
  "scopeName": "source.cobol",
  "patterns": [
    { "include": "#comment-fixed" },
    { "include": "#comment-free" },
    { "include": "#exec-block" },
    { "include": "#strings" },
    { "include": "#hex-literal" },
    { "include": "#division-header" },
    { "include": "#builtin-section-header" },
    { "include": "#named-section-header" },
    { "include": "#program-id" },
    { "include": "#id-division-paragraph" },
    { "include": "#copy-statement" },
    { "include": "#picture-clause" },
    { "include": "#level-number" },
    { "include": "#paragraph-label" },
    { "include": "#function-call" },
    { "include": "#special-register" },
    { "include": "#figurative-constant" },
    { "include": "#usage-clause" },
    { "include": "#file-control-keywords" },
    { "include": "#data-clause-keywords" },
    { "include": "#conditional-keywords" },
    { "include": "#loop-keywords" },
    { "include": "#statement-verbs" },
    { "include": "#logical-operators" },
    { "include": "#relational-words" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment-fixed": {
      "comment": "Fixed-format indicator area (column 7) comment/debug line: 6 chars then * or /",
      "match": "^.{6}[*/].*$",
      "name": "comment.line.indicator-area.cobol"
    },
    "comment-free": {
      "comment": "Free-format inline comment",
      "match": "\\*>.*$",
      "name": "comment.line.free-form.cobol"
    },
    "strings": {
      "patterns": [
        {
          "comment": "Double-quoted literal, \"\" doubling for embedded quotes",
          "match": "\"(?:[^\"]|\"\")*\"",
          "name": "string.quoted.double.cobol"
        },
        {
          "comment": "Single-quoted literal, '' doubling for embedded quotes",
          "match": "'(?:[^']|'')*'",
          "name": "string.quoted.single.cobol"
        }
      ]
    },
    "hex-literal": {
      "match": "(?i)(?<![A-Za-z0-9-])[XZ](\"[0-9A-Fa-f]*\"|'[0-9A-Fa-f]*')",
      "name": "constant.character.hex.cobol"
    },
    "exec-block": {
      "comment": "EXEC SQL / EXEC CICS / EXEC DLI ... END-EXEC embedded language block",
      "begin": "(?i)(?<![A-Za-z0-9-])EXEC(?![A-Za-z0-9-])\\s+(SQL|SQLIMS|CICS|DLI)(?![A-Za-z0-9-])",
      "beginCaptures": {
        "0": { "name": "keyword.control.exec.begin.cobol" },
        "1": { "name": "storage.type.exec-target.cobol" }
      },
      "end": "(?i)(?<![A-Za-z0-9-])END-EXEC(?![A-Za-z0-9-])\\.?",
      "endCaptures": {
        "0": { "name": "keyword.control.exec.end.cobol" }
      },
      "name": "meta.embedded.block.cobol",
      "patterns": [
        { "include": "#comment-fixed" },
        { "include": "#comment-free" },
        { "include": "#strings" },
        {
          "match": "(?i)(?<![A-Za-z0-9-])INCLUDE(?![A-Za-z0-9-])",
          "name": "keyword.control.exec.cobol"
        },
        {
          "match": ":[A-Za-z][A-Za-z0-9-]*(?::[A-Za-z][A-Za-z0-9-]*)?",
          "name": "variable.other.host.cobol"
        },
        { "include": "#numbers" }
      ]
    },
    "division-header": {
      "match": "(?i)(?<![A-Za-z0-9-])(IDENTIFICATION|ENVIRONMENT|DATA|PROCEDURE)(\\s+DIVISION)(?![A-Za-z0-9-])",
      "captures": {
        "1": { "name": "keyword.control.division.cobol" },
        "2": { "name": "keyword.control.division.cobol" }
      }
    },
    "builtin-section-header": {
      "match": "(?i)(?<![A-Za-z0-9-])(CONFIGURATION|INPUT-OUTPUT|FILE|WORKING-STORAGE|LOCAL-STORAGE|LINKAGE)(\\s+SECTION)(?![A-Za-z0-9-])",
      "captures": {
        "1": { "name": "keyword.control.section.cobol" },
        "2": { "name": "keyword.control.section.cobol" }
      }
    },
    "named-section-header": {
      "comment": "PROCEDURE DIVISION section header, e.g. 1000-MAIN SECTION.",
      "match": "(?i)^\\s*([A-Za-z0-9][A-Za-z0-9-]*)(\\s+SECTION)(?![A-Za-z0-9-])\\s*(\\.)?",
      "captures": {
        "1": { "name": "entity.name.section.cobol" },
        "2": { "name": "keyword.control.section.cobol" },
        "3": { "name": "punctuation.terminator.cobol" }
      }
    },
    "program-id": {
      "match": "(?i)(?<![A-Za-z0-9-])(PROGRAM-ID)(?![A-Za-z0-9-])\\s*(\\.)\\s*([A-Za-z0-9][A-Za-z0-9-]*)",
      "captures": {
        "1": { "name": "keyword.control.idparagraph.cobol" },
        "2": { "name": "punctuation.terminator.cobol" },
        "3": { "name": "entity.name.type.program.cobol" }
      }
    },
    "id-division-paragraph": {
      "match": "(?i)^\\s*(AUTHOR|INSTALLATION|DATE-WRITTEN|DATE-COMPILED|SECURITY|REMARKS)(?![A-Za-z0-9-])\\s*(\\.)?",
      "captures": {
        "1": { "name": "keyword.control.idparagraph.cobol" },
        "2": { "name": "punctuation.terminator.cobol" }
      }
    },
    "copy-statement": {
      "match": "(?i)(?<![A-Za-z0-9-])(COPY)(?![A-Za-z0-9-])\\s+([A-Za-z0-9][A-Za-z0-9-]*)(?:\\s+(OF|IN)(?![A-Za-z0-9-])\\s+([A-Za-z0-9][A-Za-z0-9-]*))?(?:\\s+(REPLACING)(?![A-Za-z0-9-]))?",
      "captures": {
        "1": { "name": "keyword.control.copy.cobol" },
        "2": { "name": "entity.name.type.copybook.cobol" },
        "3": { "name": "keyword.control.copy.cobol" },
        "4": { "name": "entity.name.type.copybook.cobol" },
        "5": { "name": "keyword.control.copy.cobol" }
      }
    },
    "picture-clause": {
      "match": "(?i)(?<![A-Za-z0-9-])(PIC|PICTURE)(?![A-Za-z0-9-])(?:\\s+(IS)(?![A-Za-z0-9-]))?\\s+([-+.,/9AXZVSPBGNEU0-9$()]+)",
      "captures": {
        "1": { "name": "keyword.other.picture.cobol" },
        "2": { "name": "keyword.operator.words.cobol" },
        "3": { "name": "storage.type.picture.cobol" }
      }
    },
    "level-number": {
      "comment": "Data-item level number at the start of a data-description line (01-49, 66, 77, 88)",
      "match": "^\\s*(0?[1-9]|[1-4][0-9]|66|77|88)(?=\\s)",
      "captures": {
        "1": { "name": "constant.numeric.level.cobol" }
      }
    },
    "paragraph-label": {
      "comment": "PROCEDURE DIVISION paragraph name: identifier alone at line start, terminated by a period. This rule is anchored to column 0 (^\\s*) so it would otherwise out-race every unanchored keyword rule below for reserved words that share the 'word.' shape (PROGRAM-ID., FILE-CONTROL., END-IF., CONTINUE., ...) -- excluded explicitly via the lookahead so those fall through to their proper keyword rule instead.",
      "match": "(?i)^\\s*(?!(?:PROGRAM-ID|AUTHOR|INSTALLATION|DATE-WRITTEN|DATE-COMPILED|SECURITY|REMARKS|FILE-CONTROL|I-O-CONTROL|CONTINUE|EXIT|GOBACK|END-ADD|END-CALL|END-COMPUTE|END-DELETE|END-DIVIDE|END-EVALUATE|END-IF|END-MULTIPLY|END-PERFORM|END-READ|END-RETURN|END-REWRITE|END-SEARCH|END-START|END-STRING|END-SUBTRACT|END-UNSTRING|END-WRITE)(?![A-Za-z0-9-]))([A-Za-z][A-Za-z0-9-]*)(\\.)(?=\\s|$)",
      "captures": {
        "1": { "name": "entity.name.function.paragraph.cobol" },
        "2": { "name": "punctuation.terminator.cobol" }
      }
    },
    "function-call": {
      "match": "(?i)(?<![A-Za-z0-9-])(FUNCTION)(?![A-Za-z0-9-])\\s+([A-Za-z][A-Za-z0-9-]*)",
      "captures": {
        "1": { "name": "keyword.other.function.cobol" },
        "2": { "name": "support.function.intrinsic.cobol" }
      }
    },
    "special-register": {
      "match": "(?i)(?<![A-Za-z0-9-])(RETURN-CODE|LINAGE-COUNTER|SORT-RETURN|WHEN-COMPILED|TALLY|SQLCODE|SQLSTATE|DIBGB|EIBRESP2|EIBRESP|EIBRCODE|EIBCALEN|EIBTRNID|EIBTRMID)(?![A-Za-z0-9-])",
      "name": "support.constant.special-register.cobol"
    },
    "figurative-constant": {
      "match": "(?i)(?<![A-Za-z0-9-])(ZEROES|ZEROS|ZERO|SPACES|SPACE|HIGH-VALUES|HIGH-VALUE|LOW-VALUES|LOW-VALUE|QUOTES|QUOTE|NULLS|NULL)(?![A-Za-z0-9-])",
      "name": "constant.language.figurative.cobol"
    },
    "usage-clause": {
      "comment": "DISPLAY is deliberately excluded here even though USAGE DISPLAY is valid -- as the DISPLAY verb is far more common, and both share this rule's match position, unqualified DISPLAY defers to #statement-verbs.",
      "match": "(?i)(?<![A-Za-z0-9-])(COMP-1|COMP-2|COMP-3|COMP-4|COMP-5|COMP|COMPUTATIONAL-1|COMPUTATIONAL-2|COMPUTATIONAL-3|COMPUTATIONAL-4|COMPUTATIONAL-5|COMPUTATIONAL|DISPLAY-1|BINARY|PACKED-DECIMAL|POINTER|PROCEDURE-POINTER|FUNCTION-POINTER|INDEX|USAGE)(?![A-Za-z0-9-])",
      "name": "storage.modifier.usage.cobol"
    },
    "file-control-keywords": {
      "match": "(?i)(?<![A-Za-z0-9-])(ASSIGN|ORGANIZATION|ACCESS|MODE|RECORD|ALTERNATE|DUPLICATES|FILE-STATUS|RESERVE|AREAS|AREA|PADDING|STANDARD-1|PASSWORD|LOCK|SHARING|READ-ONLY|SEQUENTIAL|INDEXED|RELATIVE|RANDOM|DYNAMIC|OPTIONAL|BLOCK|CONTAINS|RECORDS|CHARACTERS|LABEL|STANDARD|OMITTED|LINAGE|LINES|FOOTING|TOP|BOTTOM|CODE-SET|RECORDING|EXTERNAL|GLOBAL|DEPENDING|FILE-CONTROL|I-O-CONTROL|SELECT|SOURCE-COMPUTER|OBJECT-COMPUTER|SPECIAL-NAMES|DECIMAL-POINT|CURRENCY)(?![A-Za-z0-9-])",
      "name": "support.type.filecontrol.cobol"
    },
    "data-clause-keywords": {
      "match": "(?i)(?<![A-Za-z0-9-])(VALUES|VALUE|OCCURS|REDEFINES|SYNCHRONIZED|SYNC|JUSTIFIED|JUST|BLANK|SIGN|LEADING|TRAILING|SEPARATE|FD|SD)(?![A-Za-z0-9-])",
      "name": "keyword.other.dataclause.cobol"
    },
    "conditional-keywords": {
      "match": "(?i)(?<![A-Za-z0-9-])(END-IF|IF|ELSE|END-EVALUATE|EVALUATE|WHEN|OTHERWISE|OTHER)(?![A-Za-z0-9-])",
      "name": "keyword.control.conditional.cobol"
    },
    "loop-keywords": {
      "match": "(?i)(?<![A-Za-z0-9-])(END-PERFORM|PERFORM|UNTIL|VARYING|TIMES|THROUGH|THRU)(?![A-Za-z0-9-])",
      "name": "keyword.control.loop.cobol"
    },
    "statement-verbs": {
      "match": "(?i)(?<![A-Za-z0-9-])(MOVE|ADD|SUBTRACT|MULTIPLY|DIVIDE|COMPUTE|CALL|RETURN|GOBACK|GOTO|GO|STOP|EXIT|CONTINUE|ALTER|CANCEL|CHAIN|COMMIT|DELETE|DISABLE|EJECT|ENABLE|ENTER|ENTRY|EXAMINE|EXECUTE|EXHIBIT|GENERATE|INITIALIZE|INITIATE|INSPECT|INVOKE|MERGE|NOTE|ON|READY|RECEIVE|RECOVER|RELEASE|RESET|REWRITE|ROLLBACK|SEARCH|SEND|SERVICE|SET|SORT|START|STRING|SUPPRESS|TERMINATE|TRANSFORM|UNLOCK|UNSTRING|USE|READ|WRITE|OPEN|CLOSE|ACCEPT|DISPLAY|END-ADD|END-CALL|END-COMPUTE|END-DELETE|END-DIVIDE|END-MULTIPLY|END-READ|END-RETURN|END-REWRITE|END-SEARCH|END-START|END-STRING|END-SUBTRACT|END-UNSTRING|END-WRITE|INVALID\\s+KEY|INVALID|AT\\s+END|AT|END-OF-PAGE|EOP|NO\\s+REWIND|REEL|UNIT|ADVANCING|USING|INTO|FROM|BY|GIVING|REPLACING|BEFORE|AFTER)(?![A-Za-z0-9-])",
      "name": "keyword.control.statement.cobol"
    },
    "logical-operators": {
      "match": "(?i)(?<![A-Za-z0-9-])(AND|OR|NOT)(?![A-Za-z0-9-])",
      "name": "keyword.operator.logical.cobol"
    },
    "relational-words": {
      "match": "(?i)(?<![A-Za-z0-9-])(EQUAL|GREATER|LESS|THAN|TO|IS|ARE|ALL)(?![A-Za-z0-9-])",
      "name": "keyword.operator.words.cobol"
    },
    "operators": {
      "comment": "Arithmetic/relational operators. A bare - or + is only an operator when NOT joining two identifier characters on both sides (COBOL names use hyphens, e.g. WS-COUNTER).",
      "match": "(<=|>=|<>|=|<|>|\\*\\*|\\*|/)|(?<![A-Za-z0-9])[+-]|[+-](?![A-Za-z0-9])",
      "name": "keyword.operator.cobol"
    },
    "numbers": {
      "match": "(?<![\\w-])[+-]?\\d+(?:\\.\\d+)?(?![\\w-])",
      "name": "constant.numeric.cobol"
    }
  }
}
